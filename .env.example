# Optional absolute host paths. Defaults preserve the Linux deployment.
JUPYTERHUB_HUB_DIR=/srv/jupyterhub/hub
JUPYTERHUB_USERS_DIR=/srv/jupyterhub/users

# For Docker Desktop, use writable paths shared with its VM, for example:
# JUPYTERHUB_HUB_DIR=/Users/yourname/jupyterhub-data/hub
# JUPYTERHUB_USERS_DIR=/Users/yourname/jupyterhub-data/users
# Do not use relative paths or a literal ~ here.
